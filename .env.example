APP_NAME=SAM
# Producción: APP_ENV=production y APP_DEBUG=false (con debug activo los errores
# muestran trazas, rutas y variables de entorno al cliente).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Primer super-admin (operador SaaS). En producción `php artisan db:seed --force`
# siembra los catálogos y SÓLO esta cuenta (requiere email + contraseña; quita la
# contraseña del entorno tras el primer seed). Alternativa sin contraseña en env:
# php artisan sam:create-super-admin
SAM_SUPER_ADMIN_EMAIL=
SAM_SUPER_ADMIN_NAME="Operador SAM"
SAM_SUPER_ADMIN_PASSWORD=
# La consola /admin exige 2FA confirmado al super-admin (actívalo en
# /settings/security al entrar). Sólo `false` para un primer arranque.
SAM_ADMIN_REQUIRE_2FA=true

# Proxies de confianza (balanceador TLS): IPs/CIDRs separadas por coma, o `*`
# para confiar en el salto inmediato. Vacío = ninguno (dev local sin proxy).
# En producción detrás de un LB es OBLIGATORIO: sin esto la firma de Twilio
# (usa la URL completa https://) falla y los throttles por IP ven sólo al LB.
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Producción: quita LOG_STACK y LOG_LEVEL (o pon LOG_STACK=daily,json y
# LOG_LEVEL=info): sin valor, en APP_ENV=production el stack rota por día y el
# nivel es info. `single` crece sin límite; `debug` inunda el log narrativo.
LOG_STACK=single,json
# `json` = log narrativo del sistema (storage/logs/system-*.json, con trace_id). Catálogo: docs/SAM/logging.md
# LOG_JSON_STDERR=true lo manda a stderr para un agregador.
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de sesión sólo por TLS. Vacío = true en APP_ENV=production y false fuera
# (http://localhost). Sólo fíjalo para forzar otro valor.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=240

CACHE_STORE=redis
CACHE_PREFIX=sam_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=sam_

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

RUSTFS_ACCESS_KEY=sail
RUSTFS_SECRET_KEY=password
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000
RUSTFS_BUCKET=sam
# Límites de conexión a RustFS/S3 (segundos) y reintentos del SDK
RUSTFS_CONNECT_TIMEOUT=5
RUSTFS_TIMEOUT=60
RUSTFS_RETRIES=2

AI_DEFAULT=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4

PUSHER_APP_ID=sam-local
PUSHER_APP_KEY=sam-key
PUSHER_APP_SECRET=sam-secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# Twilio de plataforma: SAM opera SMS/WhatsApp/llamadas y los factura como servicio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_FROM=
TWILIO_PUBLIC_BASE_URL=
TWILIO_TTS_VOICE=Polly.Mia-Neural
TWILIO_TTS_RATE=90%

# Telescope: sólo se carga con APP_ENV=local (dependencia de desarrollo). /telescope
TELESCOPE_ENABLED=true

# SSR de Inertia: con el bundle SSR construido (`npm run build:ssr`) cada request
# renderiza contra INERTIA_SSR_URL; sin el proceso `php artisan inertia:start-ssr`
# vivo, pon INERTIA_SSR_ENABLED=false para no pagar el intento fallido.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
