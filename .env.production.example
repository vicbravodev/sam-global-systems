# Plantilla de la pestaña Environment del compose de SAM en Dokploy
# (compose.prod.yaml). Copia, reemplaza <...> y NUNCA la subas con valores.
# Genera secretos con: openssl rand -hex 32
#
# Dominios supuestos (cámbialos por los tuyos):
#   app.example.com   -> web
#   ws.example.com    -> soketi
#   media.example.com -> rustfs

# Imagen publicada por GitHub Actions (deploy.yml). `latest` = último main verde.
SAM_IMAGE=ghcr.io/vicbravodev/sam-global-systems:latest

APP_NAME=SAM
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show (en tu máquina) -> pega el valor base64:...
APP_KEY=<base64:...>
APP_URL=https://app.example.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Traefik de Dokploy es el salto inmediato: sin esto falla la firma de Twilio
# y los throttles por IP ven sólo al proxy.
TRUSTED_PROXIES=*

# Primer super-admin: `php artisan db:seed --force` siembra catálogos y sólo
# esta cuenta. Quita SAM_SUPER_ADMIN_PASSWORD tras el primer seed (o usa
# `php artisan sam:create-super-admin` y deja la contraseña vacía).
SAM_SUPER_ADMIN_EMAIL=<tu-correo>
SAM_SUPER_ADMIN_NAME="Operador SAM"
SAM_SUPER_ADMIN_PASSWORD=
SAM_ADMIN_REQUIRE_2FA=true

# Logs: archivo diario + log narrativo JSON en el volumen sam-logs, y errores a
# stderr para verlos en la pestaña Logs de Dokploy.
LOG_CHANNEL=stack
LOG_STACK=daily,json,stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Postgres = servicio "Database" de Dokploy. Host = "Internal Host" que muestra
# Dokploy en ese servicio (algo como sam-postgres-xxxxxx).
DB_CONNECTION=pgsql
DB_HOST=<internal-host-de-dokploy>
DB_PORT=5432
DB_DATABASE=sam
DB_USERNAME=sam
DB_PASSWORD=<secreto>

# Valkey (servicio `valkey` del compose).
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=<secreto>
REDIS_PREFIX=sam_
REDIS_QUEUE_RETRY_AFTER=240

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=sam_cache_
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

# Soketi: el servidor publica por la red interna; el navegador conecta a ws.
# OJO: VITE_PUSHER_* se hornean al construir la imagen (variables del repo en
# GitHub, ver deploy.yml), no se leen de aquí.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=sam
PUSHER_APP_KEY=<clave-publica>
PUSHER_APP_SECRET=<secreto>
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http

# RustFS (servicio `rustfs`). Endpoint público = dominio de media: el navegador
# abre las URLs prefirmadas ahí. Tras el primer deploy:
# php artisan storage:ensure-bucket
RUSTFS_ACCESS_KEY=<usuario>
RUSTFS_SECRET_KEY=<secreto>
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_PUBLIC_ENDPOINT=https://media.example.com
RUSTFS_BUCKET=sam

# Correo transaccional (alta de clientes /bienvenida, avisos). SMTP de tu
# proveedor (Resend, Postmark, SES...).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<usuario>
MAIL_PASSWORD=<secreto>
MAIL_FROM_ADDRESS=<no-reply@tu-dominio>
MAIL_FROM_NAME="SAM"

# IA
AI_DEFAULT=openai
OPENAI_API_KEY=<secreto>
OPENAI_TEXT_MODEL=gpt-5.4
AI_CLEF_SHADOW_ENABLED=false

# Twilio de plataforma. PUBLIC_BASE_URL = APP_URL (callbacks de estado y voz).
TWILIO_ACCOUNT_SID=<sid>
TWILIO_AUTH_TOKEN=<secreto>
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_FROM=<+52...>
TWILIO_PUBLIC_BASE_URL=https://app.example.com
TWILIO_TTS_VOICE=Polly.Mia-Neural
TWILIO_TTS_RATE=90%

TELESCOPE_ENABLED=false
# Sin proceso SSR en el compose: render sólo en cliente.
INERTIA_SSR_ENABLED=false
