includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - phpstan-baseline.neon

parameters:
    # strict-rules: todas activas salvo `dynamicCallOnStaticMethod`, que en
    # Laravel sólo da falsos positivos: el Builder de Eloquent reenvía a métodos
    # de Query\Builder (orderByDesc, count, whereIn…) y las macros (Request::validate)
    # se declaran estáticas aunque se llamen sobre una instancia.
    strictRules:
        dynamicCallOnStaticMethod: false

    level: 8
    paths:
        - app
        - routes
        - config
        - database
    tmpDir: storage/framework/cache/phpstan

    # Los modelos declaran `@return array<string, string>` en casts(); sin esto
    # Larastan ignora los casts y ve fechas/enums como string.
    parseModelCastsMethod: true

    ignoreErrors:
        # Larastan tipa las relaciones BelongsTo como no nulas aunque la fila
        # relacionada pueda no existir; el `?->` defensivo es correcto aquí.
        - identifier: nullsafe.neverNull
